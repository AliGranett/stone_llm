# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# .env is git-ignored and must never be committed.

# Required unless USE_MOCK_LLM=true.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Model used for the Research Partner.
OPENAI_MODEL=gpt-4o

# Port for the backend API server.
SERVER_PORT=3001

# true  -> sample Research Partner replies (no OpenAI calls, no key needed)
# false -> call OpenAI with the model above (requires a real OPENAI_API_KEY)
# The public demo site always uses sample replies and never reads this file.
USE_MOCK_LLM=true

# Recorded with each interaction so collected data can be traced back to the
# prompt text that produced it. Bump these when you edit the prompt files.
ANALYTICAL_PROMPT_VERSION=ANALYTICAL_V1
HYPOTHESIS_DRIVEN_PROMPT_VERSION=HYPOTHESIS_DRIVEN_V1
